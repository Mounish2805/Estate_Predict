# ==============================================================================
# EstatePredict — Environment Configuration Template
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to local SQLite; uncomment for production MySQL)
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=estatepredict
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=your_db_host.render.com
# DB_PORT=3306

# CORS & CSRF Configuration (Comma-separated origins for production Vercel frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# Production HTTPS / SSL Security (Defaults to False in local development)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Email Delivery Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EstatePredict <noreply@estatepredict.com>
